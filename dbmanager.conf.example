# -*- coding: utf-8 -*-
# =============================================================================
# DB Manager 配置文件 (dbmanager.conf)
# -----------------------------------------------------------------------------
# - 本文件为 UTF-8 编码的 INI 格式, 修改后【重启服务】生效。
# - 配置优先级: 环境变量(DBM_*) > 本文件 > 内置默认值。
#   日常配置写这里, 环境变量仅用于 CI/Docker/临时覆盖。
# - 所有键均可不填(留空), 留空则使用内置安全默认值, 不影响启动。
# - 敏感项(网关令牌/默认密码/LDAP 密码)建议留空, 由系统自动生成或走页面配置。
# =============================================================================

[server]
# 监听地址: 127.0.0.1=仅本机可访问(安全默认); 0.0.0.0=开放局域网/公网
# 局域网部署改这里即可, 无需再用环境变量
host = 127.0.0.1

# 监听端口(默认 8770)
port = 8770

# 程序数据文件位置(默认 data/ 目录 dbmanager.db; 可放数据盘/共享目录)
db_file =

# 开发模式: 1=跳过登录/错误透传详情(仅调试用, 生产勿开)
dev =

# 请求日志: 1=控制台输出每请求一行(调试用)
log =

# 1=启动不自动打开浏览器
no_open =

# 1=端口被旧实例占用时不自动接管(双实例并存)
no_kill =

# 1=启用 HTTPS(自动生成自签名证书); 也可配合 ssl_cert/ssl_key 用自有证书
ssl =

# 自有 HTTPS 证书路径(需 ssl=1 且 cert+key 同时提供)
ssl_cert =
ssl_key =

# 公网网关令牌: 留空则由系统自动生成并保存到 .dbm_gateway(推荐)
gateway_token =

# 默认连接(JSON 字符串, 如 {"name":"local","db_type":"mysql","server":"127.0.0.1","port":3306,"database":"test"})
# 免手动连接的默认连接; 含密码时仅存内存不落盘
default_conn =

[auth]
# 首次创建默认 admin 账号的密码(仅首次建库生效; 之后改密请走页面「改密」)
# ⚠️ 敏感项: 配置后明文落盘, 生产环境建议留空使用默认 admin123 并在登录后立即修改
default_pwd =

# 自助注册: 留空=开启(成员注册后需管理员审批); 0=关闭
allow_register =

# 1=强制启用账号体系(即使数据库无用户)
auth_enabled =

# --- LDAP/AD 接入(内网可选; 需安装 ldap3) ---
# LDAP 服务器地址, 如 ldap://192.168.1.10:389
ldap_url =
# 搜索根, 如 dc=company,dc=com
ldap_base =
# 可选: 绑定查询账号 DN(有则先按用户名查 DN)
ldap_binddn =
# 绑定查询账号密码(敏感项, 建议留空)
ldap_bindpw =
# 用户名属性(AD 默认 sAMAccountName; OpenLDAP 常用 uid)
ldap_attr = sAMAccountName

# ===================== [concurrency] 高并发挡板(可选, 默认已安全) =====================
# 处理请求的最大 OS 线程数(有界线程池)。500 并发时: 64 执行 + 其余排队/快速失败。
# 机器核/内存富余可调大; 别设过大(失去挡板意义)。
request_workers = 64
# 排队上限(背压): 在跑线程外最多允许这么多请求排队, 超过立即 503 快速失败。
# 留空=自动(线程数*8, 下限 128)。调小=更早拒绝; 调大=更宽容(但内存占用上升)。
request_queue =
# 单目标库连接池: 常驻连接数 / 峰值额外连接 / 池满取连超时(秒)。
# 单库并发上限 = db_pool_size + db_pool_max_overflow; 池满等 pool_timeout 秒后 5xx。
# 注意: SQLite 单连接串行(不适用这些参数), 高并发打同一 sqlite 库会排队。
db_pool_size = 10
db_pool_max_overflow = 20
db_pool_timeout = 5
